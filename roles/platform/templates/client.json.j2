{
  "clientId": {{ c.id | to_json }},
  "name": {{ c.name | to_json }},
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "secret": {{ c.secret | to_json }},
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": false,
  "rootUrl": {{ c.root_url | to_json }},
  "redirectUris": {{ c.redirect_uris | to_json }},
  "webOrigins": ["+"],
  "attributes": { "post.logout.redirect.uris": "+" },
  "protocolMappers": [
    {
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }
  ]
}
